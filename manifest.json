{
  "manifest_version": 3,
  "name": "AI Chat PDF Exporter",
  "version": "1.2.0",
  "description": "Export conversations from Claude, ChatGPT, Gemini, Perplexity, Grok, and Rovo into beautifully formatted PDF documents.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://*.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://*.atlassian.net/*",
    "https://*.atlassian.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://*.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://*.atlassian.net/*",
        "https://*.atlassian.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
